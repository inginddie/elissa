{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elissa",
  "version": "0.4.0",
  "identifier": "com.elissa.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      }
    },
    "resources": {
      "../../dist/elissa-engine/": "engine/"
    },
    "publisher": "Elissa",
    "shortDescription": "Asistente de escritorio con voz, compatible con cualquier proveedor de IA",
    "copyright": "Copyright (c) 2026 Diego Bustos",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2RTRENjJGQjVENEU4QTAKUldTZzZOUzFMOWJrWm5ZaS9OMmVnTVhxNEJROWVzMEJaUWNBa0NzMkNsa0lqNG40aFp3ZlhnMFoK",
      "endpoints": [
        "https://github.com/inginddie/elissa/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
